/* 考试答题：一张答题纸，题号条常驻 */
.exam {
    height: 100vh;
    overflow: hidden;
    padding: 0;
    background: #FFFFFF;
}

/* 顶部信息条 */
.bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 96rpx;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 32rpx;
    background: #FFFFFF;
    z-index: 30;
}

.bar__count {
    display: flex;
    align-items: baseline;
}

.bar__no {
    font-size: 36rpx;
    font-weight: 700;
    color: #10182B;
}

.bar__total {
    margin-left: 4rpx;
    font-size: 24rpx;
    color: #6B7686;
}

.bar__timer {
    display: flex;
    align-items: baseline;
    color: #4B5566;
}

.bar__timer--urgent {
    color: #C42B20;
}

.bar__timer-label {
    margin-right: 8rpx;
    font-size: 22rpx;
}

.bar__timer-value {
    font-size: 30rpx;
    font-weight: 600;
    letter-spacing: 0.5rpx;
}

/* 题号条 */
.strip {
    position: fixed;
    top: 96rpx;
    left: 0;
    right: 0;
    height: 96rpx;
    background: #FFFFFF;
    border-bottom: 2rpx solid #EDF0F6;
    z-index: 29;
    white-space: nowrap;
}

.strip__inner {
    display: flex;
    align-items: center;
    padding: 20rpx 32rpx;
    gap: 12rpx;
}

.strip__item {
    width: 56rpx;
    height: 56rpx;
    flex-shrink: 0;
    border-radius: 12rpx;
    background: #F2F4F8;
    color: #4B5566;
    font-size: 24rpx;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    font-variant-numeric: tabular-nums;
}

.strip__item--done {
    background: #E9EEFF;
    color: #2448D8;
}

.strip__item--on {
    background: #10182B;
    color: #FFFFFF;
}

/* 内容区 */
.exam__scroll {
    position: fixed;
    top: 192rpx;
    bottom: 146rpx;
    left: 0;
    right: 0;
}

.q {
    padding: 36rpx 32rpx 24rpx;
}

.q__meta {
    display: flex;
    align-items: center;
    gap: 12rpx;
}

.q__points {
    font-size: 24rpx;
    color: #6B7686;
}

.q__stem {
    margin-top: 20rpx;
    font-size: 34rpx;
    font-weight: 600;
    line-height: 1.55;
    color: #10182B;
}

.q__hint {
    margin-top: 12rpx;
    font-size: 22rpx;
    color: #6B7686;
}

/* 选项 */
.options {
    border-top: 2rpx solid #EDF0F6;
}

.option {
    display: flex;
    align-items: flex-start;
    gap: 20rpx;
    padding: 30rpx 32rpx;
    border-bottom: 2rpx solid #EDF0F6;
}

.option--hover {
    background: #FAFBFC;
}

.option--on {
    background: #F1F5FF;
}

.option__key {
    width: 48rpx;
    height: 48rpx;
    border-radius: 10rpx;
    border: 2rpx solid #DDE1E9;
    color: #4B5566;
    font-size: 24rpx;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.option__key--on {
    background: #2F5BFF;
    border-color: #2F5BFF;
    color: #FFFFFF;
}

.option__text {
    flex: 1;
    padding-top: 2rpx;
    font-size: 30rpx;
    line-height: 1.55;
    color: #10182B;
}

.option--on .option__text {
    font-weight: 600;
}

.exam__tip {
    padding: 28rpx 32rpx 0;
    font-size: 22rpx;
    line-height: 1.7;
    color: #6B7686;
}

.exam__nav {
    width: 190rpx;
    flex-shrink: 0;
}
