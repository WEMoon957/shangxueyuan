/* 学习中心 */
.head {
    background: #2F5BFF;
    padding: 28rpx 0 36rpx;
}

.head__hello {
    font-size: 40rpx;
    font-weight: 600;
    color: #FFFFFF;
    line-height: 1.3;
}

.head__org {
    margin-top: 8rpx;
    font-size: 24rpx;
    color: rgba(255, 255, 255, 0.82);
}

.head__avatar {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    border: 2rpx solid rgba(255, 255, 255, 0.36);
    color: #FFFFFF;
    font-size: 30rpx;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.head__stats {
    display: flex;
    align-items: center;
    margin-top: 32rpx;
    padding-top: 26rpx;
    border-top: 2rpx solid rgba(255, 255, 255, 0.2);
}

.head__stat {
    flex: 1;
    display: flex;
    align-items: baseline;
}

.head__value {
    font-size: 34rpx;
    font-weight: 700;
    color: #FFFFFF;
}

.head__label {
    margin-left: 8rpx;
    font-size: 22rpx;
    color: rgba(255, 255, 255, 0.82);
}

.head__divider {
    width: 2rpx;
    height: 24rpx;
    background: rgba(255, 255, 255, 0.28);
    margin: 0 16rpx;
}

/* 下一件事：深色条，页面上唯一的强调块 */
.next {
    display: flex;
    align-items: center;
    padding: 26rpx 32rpx 28rpx;
    background: #10182B;
}

.next--hover {
    background: #1A2338;
}

.next__label {
    font-size: 22rpx;
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 1rpx;
}

.next__title {
    margin-top: 6rpx;
    font-size: 32rpx;
    font-weight: 600;
    color: #FFFFFF;
    line-height: 1.35;
}

.next__meta {
    margin-top: 8rpx;
    font-size: 24rpx;
    color: rgba(255, 255, 255, 0.72);
}

.next__go {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    margin-left: 24rpx;
    font-size: 26rpx;
    font-weight: 600;
    color: #8FA6FF;
}

.next__chev {
    margin-left: 4rpx;
    font-size: 30rpx;
    line-height: 1;
}

/* 筛选：文字 + 下划线 */
.filters {
    display: flex;
    gap: 44rpx;
    padding: 30rpx 0 0;
    border-bottom: 2rpx solid #E8EBF1;
}

.filter {
    position: relative;
    padding-bottom: 18rpx;
    font-size: 28rpx;
    color: #4B5566;
}

.filter--on {
    color: #10182B;
    font-weight: 600;
}

.filter--on::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2rpx;
    height: 4rpx;
    border-radius: 2rpx;
    background: #2F5BFF;
}

.filter__n {
    margin-left: 6rpx;
    font-size: 22rpx;
    color: #8A93A3;
}

/* 课程行 */
.lesson {
    padding: 32rpx 0;
    border-bottom: 2rpx solid #EDF0F6;
}

.lesson--hover {
    background: #FAFBFC;
}

.lesson__head {
    display: flex;
    align-items: baseline;
}

.lesson__title {
    font-size: 32rpx;
    font-weight: 600;
    color: #10182B;
    line-height: 1.35;
}

.lesson__state {
    flex-shrink: 0;
    margin-left: 20rpx;
    font-size: 24rpx;
    font-weight: 600;
    color: #2F5BFF;
}

.lesson__state--done {
    color: #0E8F65;
}

.lesson__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 10rpx;
    font-size: 24rpx;
    color: #6B7686;
}

.lesson__code {
    letter-spacing: 0.4rpx;
}

.lesson__dot {
    margin: 0 8rpx;
    color: #C0C6D2;
}

.lesson__must {
    margin-left: 12rpx;
    padding: 2rpx 10rpx;
    border-radius: 6rpx;
    background: #FDF3E3;
    color: #9A5B00;
    font-size: 20rpx;
    line-height: 1.5;
}

.lesson__bar {
    margin-top: 20rpx;
}

.demo-tip {
    margin: 36rpx 0 0;
    padding-top: 24rpx;
    border-top: 2rpx solid #E8EBF1;
    font-size: 22rpx;
    line-height: 1.7;
    color: #6B7686;
}
