/* 我的 */
.head {
    background: #2F5BFF;
    padding: 28rpx 0 36rpx;
}

.head__avatar {
    width: 96rpx;
    height: 96rpx;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    border: 2rpx solid rgba(255, 255, 255, 0.36);
    color: #FFFFFF;
    font-size: 36rpx;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.head__info {
    margin-left: 24rpx;
}

.head__name {
    font-size: 40rpx;
    font-weight: 600;
    color: #FFFFFF;
    line-height: 1.3;
}

.head__org {
    margin-top: 6rpx;
    font-size: 24rpx;
    color: rgba(255, 255, 255, 0.82);
}

.head__stats {
    display: flex;
    align-items: center;
    margin-top: 32rpx;
    padding-top: 26rpx;
    border-top: 2rpx solid rgba(255, 255, 255, 0.2);
}

.head__stat {
    flex: 1;
    display: flex;
    align-items: baseline;
}

.head__value {
    font-size: 34rpx;
    font-weight: 700;
    color: #FFFFFF;
}

.head__label {
    margin-left: 8rpx;
    font-size: 22rpx;
    color: rgba(255, 255, 255, 0.82);
}

.head__divider {
    width: 2rpx;
    height: 24rpx;
    background: rgba(255, 255, 255, 0.28);
    margin: 0 16rpx;
}

/* 入口行 */
.entry {
    display: flex;
    align-items: center;
    padding: 30rpx 0;
    border-bottom: 2rpx solid #F0F2F6;
}

.entry:last-child {
    border-bottom: none;
}

.entry--hover {
    background: #FAFBFC;
}

.entry__label {
    flex: 1;
    font-size: 30rpx;
    color: #10182B;
}

.entry__meta {
    font-size: 24rpx;
    color: #6B7686;
}

.entry__chev {
    margin-left: 8rpx;
    font-size: 32rpx;
    line-height: 1;
    color: #BFC5D1;
}

/* 区块 */
.block {
    margin-top: 16rpx;
    padding: 0 32rpx 8rpx;
    background: #FFFFFF;
}

.block__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 28rpx 0 4rpx;
}

.block__text {
    padding-top: 8rpx;
    font-size: 24rpx;
    line-height: 1.7;
    color: #6B7686;
}

.block__empty {
    padding: 16rpx 0 24rpx;
    font-size: 24rpx;
    line-height: 1.7;
    color: #6B7686;
}

.block__btn {
    margin: 24rpx 0 24rpx;
    height: 80rpx;
    font-size: 28rpx;
}

/* 证书 */
.cert {
    display: flex;
    align-items: center;
    gap: 20rpx;
    padding: 24rpx 0;
    border-top: 2rpx solid #F0F2F6;
}

.cert__badge {
    width: 64rpx;
    height: 64rpx;
    border-radius: 12rpx;
    background: #FDF3E3;
    color: #9A5B00;
    font-size: 20rpx;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.cert__name {
    font-size: 28rpx;
    font-weight: 600;
    color: #10182B;
}

.cert__meta {
    margin-top: 4rpx;
    font-size: 22rpx;
    color: #6B7686;
}

/* 成绩 */
.attempt {
    display: flex;
    align-items: center;
    gap: 20rpx;
    padding: 26rpx 0;
    border-top: 2rpx solid #F0F2F6;
}

.attempt__score {
    width: 72rpx;
    flex-shrink: 0;
    font-size: 34rpx;
    font-weight: 700;
    text-align: left;
}

.attempt__score--ok {
    color: #0E8F65;
}

.attempt__score--bad {
    color: #C42B20;
}

.attempt__name {
    font-size: 28rpx;
    font-weight: 500;
    color: #10182B;
}

.attempt__meta {
    margin-top: 4rpx;
    font-size: 22rpx;
    color: #6B7686;
}

.foot {
    margin: 40rpx 0 16rpx;
    text-align: center;
    font-size: 22rpx;
    color: #9AA1AE;
}
