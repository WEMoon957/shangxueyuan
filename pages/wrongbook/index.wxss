/* 错题本 */
.wb {
    padding: 0 32rpx;
}

.wb__head {
    display: flex;
    align-items: baseline;
    padding: 32rpx 0 8rpx;
}

.wb__count {
    font-size: 40rpx;
    font-weight: 700;
    color: #C42B20;
    margin-right: 8rpx;
}

.wb__label {
    font-size: 24rpx;
    color: #6B7686;
}

.group__title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 28rpx 0 4rpx;
    border-top: 2rpx solid #EDF0F6;
    font-size: 24rpx;
    color: #6B7686;
}

.group__n {
    color: #9AA1AE;
}

.wq {
    border-top: 2rpx solid #F0F2F6;
}

.wq__head {
    display: flex;
    align-items: center;
    padding: 24rpx 0;
}

.wq__stem {
    font-size: 28rpx;
    font-weight: 600;
    line-height: 1.55;
    color: #10182B;
}

.wq__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 10rpx;
    font-size: 22rpx;
    color: #6B7686;
}

.wq__tag {
    color: #4B5566;
}

.wq__dot {
    margin: 0 8rpx;
    color: #C0C6D2;
}

.wq__status {
    color: #C42B20;
}

.wq__status--ok {
    color: #0E8F65;
}

.wq__chev {
    flex-shrink: 0;
    margin-left: 16rpx;
    font-size: 32rpx;
    line-height: 1;
    color: #BFC5D1;
    transform: rotate(90deg);
    transition: transform 0.2s ease;
}

.wq__chev--open {
    transform: rotate(-90deg);
}

.wq__body {
    padding-bottom: 28rpx;
}

.wq__opt {
    display: flex;
    align-items: flex-start;
    gap: 12rpx;
    padding: 8rpx 0;
}

.wq__opt-key {
    width: 26rpx;
    flex-shrink: 0;
    font-size: 24rpx;
    font-weight: 600;
    line-height: 1.6;
    color: #9AA1AE;
}

.wq__opt-text {
    flex: 1;
    font-size: 26rpx;
    line-height: 1.6;
    color: #4B5566;
}

.wq__answer {
    margin-top: 10rpx;
    font-size: 24rpx;
    color: #4B5566;
}

.ok-text {
    font-weight: 600;
    color: #0E8F65;
}

.wq__explain {
    margin-top: 16rpx;
    padding: 18rpx 20rpx;
    border-radius: 12rpx;
    background: #F6F7F9;
    font-size: 24rpx;
    line-height: 1.7;
    color: #4B5566;
}

.wq__explain-label {
    margin-right: 12rpx;
    font-weight: 600;
    color: #2F5BFF;
}

.wb__note {
    margin: 32rpx 0 0;
    padding-top: 24rpx;
    border-top: 2rpx solid #EDF0F6;
    font-size: 22rpx;
    line-height: 1.7;
    color: #6B7686;
}
