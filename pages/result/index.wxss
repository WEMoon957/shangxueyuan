/* 成绩单：判分结果 + 逐题核对清单 */
.page--sheet {
    padding-bottom: 200rpx;
}

.verdict {
    padding: 36rpx 32rpx 32rpx;
}

.verdict--pass {
    background: #EAF7F1;
}

.verdict--fail {
    background: #FDF0EF;
}

.verdict__exam {
    font-size: 24rpx;
    color: #4B5566;
}

.verdict__main {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-top: 8rpx;
}

.verdict__score {
    display: flex;
    align-items: baseline;
}

.verdict__value {
    font-size: 108rpx;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -2rpx;
    color: #0E8F65;
}

.verdict--fail .verdict__value {
    color: #C42B20;
}

.verdict__unit {
    margin-left: 8rpx;
    font-size: 28rpx;
    font-weight: 600;
    color: #0E8F65;
}

.verdict--fail .verdict__unit {
    color: #C42B20;
}

.verdict__flag {
    margin-bottom: 14rpx;
    padding: 8rpx 22rpx;
    border-radius: 999rpx;
    background: #0E8F65;
    color: #FFFFFF;
    font-size: 24rpx;
    font-weight: 600;
}

.verdict--fail .verdict__flag {
    background: #C42B20;
}

.verdict__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 18rpx;
    font-size: 24rpx;
    color: #4B5566;
}

.verdict__dot {
    margin: 0 10rpx;
    color: #A9B0BC;
}

/* 清单 */
.review__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 36rpx 32rpx 8rpx;
    border-top: 2rpx solid #EDF0F6;
}

.item {
    padding: 28rpx 32rpx 32rpx;
}

.item + .item {
    border-top: 2rpx solid #EDF0F6;
}

.item__head {
    display: flex;
    align-items: flex-start;
    gap: 16rpx;
}

.item__no {
    width: 40rpx;
    flex-shrink: 0;
    font-size: 28rpx;
    font-weight: 700;
    line-height: 1.5;
}

.item__no--ok {
    color: #0E8F65;
}

.item__no--bad {
    color: #C42B20;
}

.item__stem {
    font-size: 30rpx;
    font-weight: 600;
    line-height: 1.5;
    color: #10182B;
}

.item__tags {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10rpx;
    margin-top: 12rpx;
}

.item__mark {
    font-size: 22rpx;
    font-weight: 600;
}

.item__mark--ok {
    color: #0E8F65;
}

.item__mark--bad {
    color: #C42B20;
}

/* 选项 */
.item__options {
    margin-top: 16rpx;
    margin-left: 56rpx;
}

.opt {
    display: flex;
    align-items: flex-start;
    gap: 12rpx;
    padding: 12rpx 16rpx;
    border-radius: 10rpx;
    margin-bottom: 8rpx;
}

.opt--right {
    background: #EAF7F1;
}

.opt--wrong {
    background: #FDF0EF;
}

.opt__key {
    width: 26rpx;
    flex-shrink: 0;
    font-size: 26rpx;
    font-weight: 600;
    line-height: 1.5;
    color: #4B5566;
}

.opt__text {
    flex: 1;
    font-size: 26rpx;
    line-height: 1.55;
    color: #10182B;
}

.opt__mark {
    flex-shrink: 0;
    font-size: 20rpx;
    line-height: 1.9;
    font-weight: 600;
}

.opt__mark--ok {
    color: #0E8F65;
}

.opt__mark--bad {
    color: #C42B20;
}

/* 答案与解析 */
.item__answer {
    display: flex;
    align-items: center;
    margin-top: 14rpx;
    margin-left: 56rpx;
    font-size: 24rpx;
    color: #4B5566;
}

.item__ans-sep {
    margin: 0 12rpx;
    color: #C0C6D2;
}

.item__ans-ok {
    font-weight: 600;
    color: #0E8F65;
}

.item__ans-bad {
    font-weight: 600;
    color: #C42B20;
}

.item__explain {
    margin: 18rpx 0 0 56rpx;
    padding: 18rpx 20rpx;
    border-radius: 12rpx;
    background: #F6F7F9;
    font-size: 24rpx;
    line-height: 1.7;
    color: #4B5566;
}

.item__explain-label {
    margin-right: 12rpx;
    font-weight: 600;
    color: #2F5BFF;
}

.review__note {
    padding: 24rpx 32rpx 0;
    border-top: 2rpx solid #EDF0F6;
    font-size: 22rpx;
    line-height: 1.7;
    color: #6B7686;
}

.footer-bar__sub {
    width: 200rpx;
    flex-shrink: 0;
    font-size: 28rpx;
}
