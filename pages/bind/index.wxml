<!-- 首次绑定 -->
<view class="page page--sheet">
  <view class="bind">
    <view class="bind__title">完善学员信息</view>
    <view class="bind__sub">首次进入绑定一次，之后系统自动识别你，学习和考试成绩都记在同一个人名下。</view>

    <view class="field">
      <text class="field__label">姓名</text>
      <input
        class="field__input"
        placeholder="填写身份证上的姓名"
        placeholder-class="field__ph"
        value="{{form.name}}"
        maxlength="12"
        data-key="name"
        bindinput="onInput"
      />
    </view>

    <view class="field">
      <text class="field__label">手机号</text>
      <input
        class="field__input"
        type="number"
        placeholder="11 位手机号，用于成绩核对"
        placeholder-class="field__ph"
        value="{{form.phone}}"
        maxlength="11"
        data-key="phone"
        bindinput="onInput"
      />
    </view>

    <view class="field">
      <text class="field__label">所属门店</text>
      <input
        class="field__input"
        placeholder="例如：万象城店"
        placeholder-class="field__ph"
        value="{{form.storeName}}"
        maxlength="20"
        data-key="storeName"
        bindinput="onInput"
      />
    </view>

    <view class="field field--last">
      <text class="field__label">岗位角色</text>
      <picker range="{{positions}}" value="{{positionIndex}}" bindchange="onPosition">
        <view class="field__picker">
          <text class="{{form.position ? 'field__value' : 'field__ph'}}">{{form.position || '请选择'}}</text>
          <text class="field__arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="consent" bindtap="toggleConsent">
      <view class="consent__box {{agreed ? 'consent__box--on' : ''}}">
        <text wx:if="{{agreed}}" class="consent__tick">✓</text>
      </view>
      <view class="grow">
        <text class="consent__text">我已阅读并同意</text>
        <text class="consent__link" catchtap="showPrivacy">《学员信息使用说明》</text>
      </view>
    </view>

    <view class="bind__error" wx:if="{{error}}">{{error}}</view>

    <view
      class="btn btn--primary bind__submit {{canSubmit ? '' : 'btn--disabled'}}"
      hover-class="{{canSubmit ? 'btn-hover' : ''}}"
      bindtap="submit"
    >{{submitting ? '提交中…' : '绑定并开始学习'}}</view>

    <view class="bind__tip">姓名、手机号、门店为最小必要信息，仅用于学习记录与成绩核对，可在门店管理员处修改。</view>
  </view>
</view>
