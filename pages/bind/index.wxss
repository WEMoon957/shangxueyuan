/* 首次绑定 */
.bind {
    padding: 40rpx 32rpx 60rpx;
}

.bind__title {
    font-size: 44rpx;
    font-weight: 700;
    line-height: 1.28;
    color: #10182B;
}

.bind__sub {
    margin-top: 16rpx;
    font-size: 26rpx;
    line-height: 1.7;
    color: #4B5566;
}

.field {
    padding: 28rpx 0;
    border-bottom: 2rpx solid #EDF0F6;
}

.field--last {
    border-bottom: none;
}

.field__label {
    display: block;
    font-size: 24rpx;
    color: #6B7686;
}

.field__input {
    margin-top: 8rpx;
    height: 56rpx;
    font-size: 34rpx;
    font-weight: 500;
    color: #10182B;
}

.field__value {
    font-size: 34rpx;
    font-weight: 500;
    color: #10182B;
}

.field__ph {
    color: #9AA1AE;
    font-weight: 400;
}

.field__picker {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 8rpx;
    height: 56rpx;
}

.field__arrow {
    color: #BFC5D1;
    font-size: 34rpx;
    line-height: 1;
}

.consent {
    display: flex;
    align-items: center;
    gap: 16rpx;
    margin-top: 36rpx;
}

.consent__box {
    width: 36rpx;
    height: 36rpx;
    border-radius: 8rpx;
    border: 2rpx solid #D5DAE3;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.consent__box--on {
    background: #2F5BFF;
    border-color: #2F5BFF;
}

.consent__tick {
    color: #FFFFFF;
    font-size: 22rpx;
    line-height: 1;
}

.consent__text {
    font-size: 24rpx;
    color: #4B5566;
}

.consent__link {
    font-size: 24rpx;
    color: #2F5BFF;
}

.bind__error {
    margin-top: 24rpx;
    padding: 18rpx 20rpx;
    border-radius: 12rpx;
    background: #FDF0EF;
    color: #C42B20;
    font-size: 24rpx;
}

.bind__submit {
    margin-top: 40rpx;
}

.bind__tip {
    margin-top: 28rpx;
    font-size: 22rpx;
    line-height: 1.7;
    color: #6B7686;
    text-align: center;
}
